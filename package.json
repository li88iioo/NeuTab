{
  "name": "neu-tab",
  "displayName": "NeuTab",
  "version": "1.0.7",
  "packageManager": "pnpm@12.15.0",
  "description": "Simple neumorphic browser homepage with search and quick launch",
  "author": "NeuTab Contributors",
  "scripts": {
    "postinstall": "node ./scripts/patch-plasmo-templates.mjs",
    "build:packages": "pnpm --filter @neutab/shared build && pnpm --filter @neutab/ui build",
    "dev": "pnpm build:packages && plasmo dev",
    "dev:firefox": "pnpm build:packages && node node_modules/plasmo/bin/index.mjs dev --target=firefox-mv3",
    "build": "pnpm build:packages && plasmo build && node ./scripts/patch-build-html-paths.mjs",
    "build:firefox": "pnpm build:packages && node node_modules/plasmo/bin/index.mjs build --target=firefox-mv3 && node ./scripts/patch-firefox-build.mjs && node ./scripts/patch-build-html-paths.mjs",
    "package": "pnpm build && plasmo package && node ./scripts/patch-build-html-paths.mjs && node ./scripts/sync-build-dev.mjs",
    "package:firefox": "pnpm build:firefox && node node_modules/plasmo/bin/index.mjs package --target=firefox-mv3 && node ./scripts/patch-firefox-build.mjs && node ./scripts/patch-build-html-paths.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@neutab/shared": "workspace:*",
    "@neutab/ui": "workspace:*",
    "@plasmohq/storage": "^1.15.0",
    "lz-string": "^1.5.0",
    "plasmo": "0.90.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@plasmohq/parcel-resolver": "^0.14.2",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "host_permissions": [],
    "permissions": [
      "storage",
      "favicon",
      "bookmarks",
      "topSites",
      "history"
    ]
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "browsers": [
      "last 1 Chrome version",
      "last 1 Firefox version"
    ]
  }
}
